<Window x:Class="InputAtlas.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InputAtlas.App"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="InputAtlas 输入图谱" Width="1280" Height="800" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen" Closing="WindowClosing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="InputAtlas" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="输入图谱" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,35,0,0">
                    <Button Content="首页" Command="{Binding NavigateCommand}" CommandParameter="0" HorizontalContentAlignment="Left" />
                    <Button Content="趋势" Command="{Binding NavigateCommand}" CommandParameter="1" HorizontalContentAlignment="Left" />
                    <Button Content="历史" Command="{Binding NavigateCommand}" CommandParameter="2" HorizontalContentAlignment="Left" />
                    <Button Content="设置" Command="{Binding NavigateCommand}" CommandParameter="3" HorizontalContentAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LastSavedText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="74" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="26,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentDate}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TimeZoneLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </StackPanel>
                    <Button Content="刷新" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="80" />
                </Grid>
            </Border>

            <TabControl Grid.Row="1" SelectedIndex="{Binding PageIndex}" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
                </TabControl.Resources>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22">
                            <UniformGrid Columns="6" Margin="-5,0,-5,16">
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="今日键盘" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding KeyboardCount}" FontSize="30" FontWeight="Bold" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="今日鼠标" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding MouseCount}" FontSize="30" FontWeight="Bold" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="滚轮格数" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding WheelCount}" FontSize="30" FontWeight="Bold" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="活跃分数" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding ActivityScore}" FontSize="30" FontWeight="Bold" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="已使用" Foreground="{StaticResource MutedTextBrush}" /><TextBlock FontSize="30" FontWeight="Bold"><Run Text="{Binding UsedDays}" /><Run Text=" 天" FontSize="14" /></TextBlock></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="已活跃" Foreground="{StaticResource MutedTextBrush}" /><TextBlock FontSize="30" FontWeight="Bold"><Run Text="{Binding ActiveDays}" /><Run Text=" 天" FontSize="14" /></TextBlock></StackPanel></Border>
                            </UniformGrid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="225" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource MetricCard}" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="360" /></Grid.RowDefinitions>
                                        <TextBlock Text="键盘热力图" FontSize="17" FontWeight="SemiBold" Margin="4,0,0,8" />
                                        <local:KeyboardHeatmapControl Grid.Row="1" Layout="{Binding KeyboardLayout}" Counts="{Binding InputCounts}" SelectedInput="{Binding SelectedInput}" InputSelected="KeyboardSelected" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <Border Style="{StaticResource MetricCard}">
                                        <StackPanel>
                                            <TextBlock Text="通用五键鼠标" FontSize="16" FontWeight="SemiBold" />
                                            <local:MouseHeatmapControl Counts="{Binding InputCounts}" Height="230" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MetricCard}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedInputTitle}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedInputDetail}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="活跃分数 = 键盘按键 + 鼠标按键 + 滚轮格数 × 0.2" Foreground="{StaticResource MutedTextBrush}" Margin="8,10" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid Margin="26">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource MetricCard}"><oxy:PlotView Model="{Binding TrendPlot}" /></Border>
                        <Border Grid.Row="1" Style="{StaticResource MetricCard}"><oxy:PlotView Model="{Binding ActivityPlot}" /></Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <StackPanel Margin="30">
                        <TextBlock Text="历史统计" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="按当前有效时区动态聚合；缺失覆盖不会被当成零。" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,18" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,14,0"><TextBlock Text="开始日期" /><DatePicker SelectedDate="{Binding HistoryStart}" Width="180" /></StackPanel>
                            <StackPanel Margin="0,0,14,0"><TextBlock Text="结束日期" /><DatePicker SelectedDate="{Binding HistoryEnd}" Width="180" /></StackPanel>
                            <Button Content="查询" Command="{Binding QueryHistoryCommand}" Width="90" VerticalAlignment="Bottom" />
                        </WrapPanel>
                        <Border Style="{StaticResource MetricCard}" Margin="0,24,0,0">
                            <TextBlock Text="{Binding HistorySummary}" FontSize="20" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="键盘配列" FontWeight="SemiBold" Margin="0,24,0,5" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="ANSI 104" Click="AnsiLayoutClick" Width="120" />
                                <Button Content="75% 配列" Click="CompactLayoutClick" Width="120" Margin="8,4,0,4" />
                            </StackPanel>
                            <TextBlock Text="记录控制" FontWeight="SemiBold" Margin="0,22,0,5" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="暂停 / 恢复" Click="ToggleCaptureClick" Width="130" />
                                <Button Content="立即保存" Click="SaveNowClick" Width="110" Margin="8,4,0,4" />
                            </StackPanel>
                            <TextBlock Text="数据管理" FontWeight="SemiBold" Margin="0,22,0,5" />
                            <WrapPanel>
                                <Button Content="导出今日 CSV" Click="ExportClick" Width="130" />
                                <Button Content="创建备份" Click="BackupClick" Width="110" Margin="8,4,0,4" />
                                <Button Content="恢复备份" Click="RestoreClick" Width="110" Margin="8,4,0,4" />
                                <Button Content="删除历史页所选范围" Click="DeleteRangeClick" Width="170" Margin="8,4,0,4" />
                            </WrapPanel>
                            <CheckBox Content="登录 Windows 后自动启动" IsChecked="{Binding Settings.StartWithWindows}" Click="AutostartClick" Margin="0,20,0,0" />
                            <Separator Margin="0,24" Background="{StaticResource BorderBrush}" />
                            <TextBlock Text="数据目录" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DataDirectory}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,18,0,0" />
                            <TextBlock Text="完全离线 · 不记录输入内容 · 第三方许可证见 Licenses 目录" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
