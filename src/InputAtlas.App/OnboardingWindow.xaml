<Window x:Class="InputAtlas.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 InputAtlas" Width="720" Height="540"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="InputAtlas 输入图谱" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="完全离线，只统计次数，不记录输入内容" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <TabControl x:Name="Steps" Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}">
            <TabItem Header="1  隐私">
                <StackPanel Margin="28">
                    <TextBlock Text="明确的隐私边界" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <TextBlock TextWrapping="Wrap" FontSize="15" LineHeight="25"
                               Text="InputAtlas 只保存每 5 分钟桶内的按键次数、鼠标按钮次数、滚轮格数和覆盖时间。不会保存字符、按键顺序、组合键、窗口、进程、鼠标坐标、设备名称或任何可还原输入内容的数据。应用不会联网。" />
                </StackPanel>
            </TabItem>
            <TabItem Header="2  外观">
                <StackPanel Margin="28">
                    <TextBlock Text="选择键盘配列" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <TextBlock Text="配列仅改变可视化，不改变底层计数。" Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox x:Name="LayoutChoice" SelectedIndex="0" Margin="0,16,0,8">
                        <ComboBoxItem Content="ANSI 104 全尺寸" />
                        <ComboBoxItem Content="75% 配列" />
                    </ComboBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="3  后台">
                <StackPanel Margin="28">
                    <TextBlock Text="后台记录" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <CheckBox x:Name="StartWithWindows" Content="登录 Windows 后自动启动（推荐）" Margin="0,8" />
                    <CheckBox x:Name="KeepForever" Content="永久保留 5 分钟明细（默认保留 365 天）" Margin="0,8" />
                    <TextBlock Text="点击“开始记录”后才会注册 Raw Input。" Foreground="{StaticResource MutedTextBrush}" Margin="0,18,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Content="上一步" Width="100" Click="BackClick" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="NextButton" Content="下一步" Width="100" Click="NextClick" />
                <Button x:Name="StartButton" Content="开始记录" Width="120" Background="{StaticResource AccentBrush}" Visibility="Collapsed" Click="StartClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

