<Window x:Class="InputAtlas.App.Pet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InputAtlas 桌宠"
        Width="420"
        Height="336"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Grid x:Name="PetSurface"
          Background="Transparent"
          MouseLeftButtonDown="PetSurfaceMouseLeftButtonDown"
          MouseLeftButtonUp="PetSurfaceMouseLeftButtonUp"
          MouseMove="PetSurfaceMouseMove"
          LostMouseCapture="PetSurfaceLostMouseCapture">
        <Image x:Name="FrameImage"
               Stretch="Uniform"
               RenderTransformOrigin="0.5,0.76"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PulseTranslate" Y="0" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <Border x:Name="AdjustmentOutline"
                Visibility="Collapsed"
                BorderBrush="#FF7B3FE4"
                BorderThickness="3"
                CornerRadius="12"
                Background="#12000000"
                IsHitTestVisible="False" />
    </Grid>
</Window>
